# El formulario usa el PRIMERO de estos backends que esté configurado (en este
# orden de prioridad). Copiar este archivo a .env (local) y definir las mismas
# variables en Vercel al desplegar.

# Opción A — Supabase (activa): inserta cada lead en la tabla public.leads.
# 1. Crear proyecto en https://supabase.com y ejecutar supabase/leads.sql
#    en el SQL Editor (crea la tabla con seguridad de solo-insertar).
# 2. Copiar de Settings → API: Project URL y la clave "anon public".
#    La anon key es pública por diseño; la RLS impide leer los leads con ella.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Opción B — Web3Forms: entrega los leads por correo, sin base de datos.
# Access Key gratis en https://web3forms.com (también es pública por diseño).
PUBLIC_WEB3FORMS_KEY=

# Opción C — Webhook de n8n (máxima prioridad si está definida; para cuando
# exista una instancia propia de n8n con un workflow de leads).
PUBLIC_N8N_WEBHOOK_URL=
