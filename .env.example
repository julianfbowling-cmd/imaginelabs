# El formulario funciona con el PRIMERO de estos backends que esté configurado.
# Copiar este archivo a .env (local) y definir las mismas variables en Vercel.

# Opción A — Web3Forms (recomendada para empezar: gratis, sin servidor).
# 1. Entra a https://web3forms.com y crea una Access Key con tu correo.
# 2. Pégala aquí. Los leads llegan a ese correo. La clave es pública por diseño.
PUBLIC_WEB3FORMS_KEY=

# Opción B — Webhook de n8n (cuando exista una instancia de n8n).
# Workflow con nodo Webhook (POST, CORS con el dominio del sitio) que reciba
# el JSON del lead. Si esta variable está definida, tiene prioridad sobre A.
PUBLIC_N8N_WEBHOOK_URL=
