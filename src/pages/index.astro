---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import HeroVisual from '../components/HeroVisual.astro';
import LeadForm from '../components/LeadForm.astro';
import ProcessStory from '../components/ProcessStory.astro';
import { SERVICES, TECH } from '../config.js';

const guarantees = [
  'Diagnóstico gratuito de 30 minutos',
  'Propuesta con inversión fija en 24 h hábiles',
  'KPIs y medición desde el día uno',
  'Acompañamiento después del lanzamiento',
];

const stack = Object.values(TECH);

---

<Base>
  <Nav />

  <section class="relative overflow-hidden bg-[linear-gradient(155deg,#0C1650_0%,#142878_52%,#0A1240_100%)] text-white">
    <div class="absolute top-28 -right-16 h-[460px] w-[460px] rounded-full bg-[rgba(111,227,244,0.14)] blur-[90px]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-20">
      <div class="flex flex-col items-start gap-7">
        <span class="eyebrow border-cardnavyline text-textblue max-w-full rounded-full border bg-[rgba(20,34,110,0.5)] px-4 py-1.5 text-center">
          Web · IA · Automatización — Colombia
        </span>
        <h1 class="font-display text-[40px] leading-[1.08] font-extrabold tracking-tight text-balance sm:text-[52px] lg:text-[60px]">
          La operación
          <span class="bg-gradient-to-r from-cyan to-peri bg-clip-text text-transparent">inteligente</span>
          que tu empresa necesita.
        </h1>
        <p class="text-textsoft max-w-[52ch] text-lg leading-relaxed">
          Sitios web, agentes de IA y automatizaciones que capturan clientes, responden en segundos y
          liberan a tu equipo del trabajo repetitivo.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#contacto"
            class="bg-cyan text-oncyan rounded-full px-8 py-4 font-extrabold transition hover:brightness-105"
          >
            Agendar diagnóstico gratuito
          </a>
          <a
            href="#servicios"
            class="rounded-full border-[1.5px] border-[#33489F] px-8 py-4 font-bold text-white transition hover:border-[#4a5fc0]"
          >
            Ver servicios
          </a>
        </div>
        <span class="text-textblue font-mono text-[12.5px]">
          Propuesta con alcance e inversión fija en 24 h hábiles.
        </span>
      </div>
      <div class="hidden justify-self-end lg:block">
        <HeroVisual />
      </div>
    </div>
  </section>

  <section class="bg-deep px-6 py-11 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-5">
      <span class="eyebrow text-textdim text-center tracking-[0.16em]">Construimos sobre tecnología probada</span>
      <ul class="flex flex-wrap items-stretch justify-center gap-4">
        {
          stack.map((tech) => (
            <li class="border-navline flex items-center gap-2.5 rounded-xl border px-6 py-3">
              {tech.wordmark ? (
                <img src={tech.logo} alt={tech.name} class={tech.imgClass} loading="lazy" />
              ) : (
                <>
                  <img src={tech.logo} alt="" class={tech.iconClass ?? 'h-6 w-auto'} loading="lazy" />
                  <span class="text-textmid font-extrabold">{tech.name}</span>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="servicios" class="bg-surface scroll-mt-20 px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Servicios</span>
        <h2 class="font-display max-w-[24ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Todo lo que tu negocio necesita para crecer en digital.
        </h2>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          SERVICES.map((service) => (
            <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
              <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl">
                <Icon name={service.icon} size={26} />
              </span>
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-display text-xl font-bold">{service.title}</h3>
                {service.badge && (
                  <span class="from-cyan to-peri text-oncyan rounded-full bg-gradient-to-r px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">
                    {service.badge}
                  </span>
                )}
              </div>
              <p class="text-inksoft leading-relaxed">{service.description}</p>
              {
                service.href && (
                  <a href={service.href} class="text-action text-[15px] font-bold hover:underline">
                    Conocer el servicio
                  </a>
                )
              }
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="por-que" class="scroll-mt-20 bg-white px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:gap-18">
      <div class="order-2 flex justify-center lg:order-1">
        <div class="flex h-[380px] w-full max-w-[520px] items-center justify-center overflow-hidden rounded-[52%_48%_45%_55%/48%_55%_45%_52%] bg-[linear-gradient(150deg,#0F1D66,#1B32A8)] sm:h-[440px]">
          <div class="bg-cardnavy border-cardnavyline flex w-[330px] max-w-[86%] flex-col gap-3.5 rounded-2xl border p-5 font-mono text-[12.5px] shadow-[0_24px_60px_rgba(5,10,40,0.5)]">
            <div class="border-b border-[#22347F] pb-3">
              <div class="flex items-center justify-between">
                <span class="text-[#8DA0E8]">agente · flujo-leads</span>
                <span class="bg-cyan inline-block h-2 w-2 rounded-full"></span>
              </div>
            </div>
            <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Lead recibido · formulario</span></div>
            <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Intención alta (0,92)</span></div>
            <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">WhatsApp enviado · 38 s</span></div>
            <div class="flex items-center gap-2.5"><span class="inline-block h-[7px] w-[7px] rounded-full bg-[#556AC9]"></span><span class="text-[#8DA0E8]">CRM actualizado</span></div>
            <span class="text-[10.5px] text-[#7D8FD9]">simulación de ejemplo</span>
          </div>
        </div>
      </div>
      <div class="order-1 flex flex-col items-start gap-5 lg:order-2">
        <span class="eyebrow text-action">Por qué nosotros</span>
        <h2 class="font-display text-3xl font-bold tracking-tight text-balance lg:text-[38px]">
          Menos trabajo manual, más ventas.
        </h2>
        <p class="text-inksoft max-w-[54ch] leading-relaxed">
          No vendemos horas ni promesas: definimos contigo qué automatizar, cuánto cuesta y cómo se va
          a medir — antes de escribir una línea de código.
        </p>
        <ul class="flex flex-col gap-3.5">
          {
            guarantees.map((item) => (
              <li class="flex items-center gap-3">
                <Icon name="check" size={20} class="text-action shrink-0" />
                <span class="font-semibold">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <ProcessStory />

  <section class="bg-surface px-6 pb-20 lg:px-10 lg:pb-24">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-3xl bg-[linear-gradient(150deg,#0F1D66_0%,#1B32A8_60%,#14267B_100%)] p-10 text-white lg:flex-row lg:items-center lg:p-16">
      <div class="flex max-w-[58ch] flex-col gap-3">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance lg:text-4xl">
          Tu próximo cliente escribe a las 11&nbsp;p.&nbsp;m.
        </h2>
        <p class="text-textsoft text-lg leading-relaxed">
          Un agente bien entrenado le responde en segundos — y tú decides al día siguiente con la
          información completa.
        </p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-3">
        <a
          href="#contacto"
          class="bg-cyan text-oncyan rounded-full px-8 py-4 text-center font-extrabold transition hover:brightness-105"
        >
          Agendar diagnóstico gratuito
        </a>
        <span class="text-textblue font-mono text-xs">30 minutos · sin compromiso</span>
      </div>
    </div>
  </section>

  <section id="contacto" class="scroll-mt-20 bg-white px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col items-start gap-5">
        <span class="eyebrow text-action">Contacto</span>
        <h2 class="font-display text-3xl font-bold tracking-tight text-balance lg:text-[38px]">
          Agenda tu diagnóstico gratuito.
        </h2>
        <p class="text-inksoft max-w-[50ch] leading-relaxed">
          Cuéntanos tu objetivo comercial y te contactamos con una evaluación inicial y una propuesta
          de alcance en menos de 24 horas hábiles.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-3">
            <Icon name="check" size={20} class="text-action shrink-0" />
            <span class="font-semibold">Sin compromiso</span>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="check" size={20} class="text-action shrink-0" />
            <span class="font-semibold">Sabrás qué automatizar primero</span>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="check" size={20} class="text-action shrink-0" />
            <span class="font-semibold">Respuesta de un consultor, no de un bot</span>
          </li>
        </ul>
      </div>
      <div class="border-cardline bg-surface rounded-3xl border p-7 lg:p-10">
        <LeadForm />
      </div>
    </div>
  </section>

  <Footer />
</Base>
