---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import StoryTimeline from '../components/StoryTimeline.astro';
import TechStrip from '../components/TechStrip.astro';
---

<Base
  title="Soporte y Mantenimiento Web"
  description="Monitoreo, seguridad, copias de respaldo y mejoras continuas para tu sitio, tienda o software, con un plan mensual fijo."
  path="/soporte-y-mantenimiento/"
>
  <Nav />

  <section class="relative overflow-hidden bg-[linear-gradient(155deg,#0C1650_0%,#142878_52%,#0A1240_100%)] text-white">
    <div class="absolute top-24 -right-16 h-[420px] w-[420px] rounded-full bg-[rgba(111,227,244,0.14)] blur-[90px]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-20">
      <div class="flex flex-col items-start gap-7">
        <span class="eyebrow border-cardnavyline text-textblue max-w-full rounded-full border bg-[rgba(20,34,110,0.5)] px-4 py-1.5 text-center">
          Servicio · Soporte y mantenimiento
        </span>
        <h1 class="font-display text-[38px] leading-[1.08] font-extrabold tracking-tight text-balance sm:text-[48px] lg:text-[54px]">
          Tu operación digital,
          <span class="bg-gradient-to-r from-cyan to-peri bg-clip-text text-transparent">siempre en línea</span>.
        </h1>
        <p class="text-textsoft max-w-[52ch] text-lg leading-relaxed">
          Monitoreo, seguridad, copias de respaldo y mejoras continuas con un plan mensual fijo,
          para que tú te ocupes del negocio, no del servidor.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 font-extrabold transition hover:brightness-105">
            Agendar diagnóstico gratuito
          </a>
          <a href="/#servicios" class="rounded-full border-[1.5px] border-[#33489F] px-8 py-4 font-bold text-white transition hover:border-[#4a5fc0]">
            Ver todos los servicios
          </a>
        </div>
        <span class="text-textblue font-mono text-[12.5px]">También cuidamos sitios que no construimos nosotros.</span>
      </div>

      <div class="hidden justify-self-end lg:block">
        <div class="bg-cardnavy border-cardnavyline flex w-[380px] flex-col gap-3.5 rounded-2xl border p-6 shadow-[0_24px_60px_rgba(5,10,40,0.55)]">
          <div class="flex items-center justify-between border-b border-[#22347F] pb-3">
            <span class="font-mono text-[13px] text-[#8DA0E8]">Estado de tus servicios</span>
            <span class="rounded-full border border-[#2A3F9E] px-3 py-1 font-mono text-[10.5px] tracking-wider text-[#8DA0E8] uppercase">ejemplo</span>
          </div>
          <div class="flex items-center justify-between"><div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[14px] text-[#D5DDFA]">Sitio web</span></div><span class="text-cyan text-[13px] font-bold">En línea</span></div>
          <div class="flex items-center justify-between"><div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[14px] text-[#D5DDFA]">Tienda</span></div><span class="text-cyan text-[13px] font-bold">En línea</span></div>
          <div class="flex items-center justify-between"><div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[14px] text-[#D5DDFA]">Certificado SSL</span></div><span class="text-cyan text-[13px] font-bold">Vigente</span></div>
          <div class="flex items-center justify-between"><div class="flex items-center gap-2.5"><span class="inline-block h-[7px] w-[7px] rounded-full bg-[#556AC9]"></span><span class="text-[14px] text-[#D5DDFA]">Última copia de respaldo</span></div><span class="text-[13px] font-bold text-[#AEBBF0]">hace 2 h</span></div>
          <span class="border-t border-[#22347F] pt-3 font-mono text-[10.5px] text-[#7D8FD9]">monitoreo continuo · alertas automáticas</span>
        </div>
      </div>
    </div>
  </section>

  <TechStrip names={['aws', 'azure', 'shopify', 'woocommerce']} label="Cuidamos operaciones en" />

  <section class="bg-surface px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Qué incluye</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Un equipo técnico de guardia, sin contratar uno.
        </h2>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="shield" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Monitoreo y alertas</h3>
          <p class="text-inksoft leading-relaxed">Vigilamos tu sitio de forma continua: si algo se cae o se pone lento, nos enteramos nosotros antes que tus clientes.</p>
        </article>
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="check" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Seguridad y respaldos</h3>
          <p class="text-inksoft leading-relaxed">Actualizaciones, certificados y copias de respaldo automáticas: si algo falla, tu operación se restaura sin drama.</p>
        </article>
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="circuit" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Horas de mejora mensual</h3>
          <p class="text-inksoft leading-relaxed">Tu plan incluye horas para cambios, contenido nuevo y pequeñas funciones: tu sitio evoluciona en vez de envejecer.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="scroll-mt-20 overflow-hidden bg-white px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Cómo trabajamos</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Del susto de medianoche a dormir tranquilo.
        </h2>
      </div>

      <StoryTimeline>
        <ol class="flex flex-col gap-16">
          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:items-end lg:pr-16 lg:text-right">
              <span class="eyebrow text-action">Día 0</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Nos cuentas qué te quita el sueño</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                En 30 minutos revisamos el estado de tu sitio o tienda: hosting, seguridad,
                copias de respaldo y qué pasaría hoy si algo fallara.
              </p>
            </div>
            <div class="lg:pl-16">
              <div class="border-cardline bg-surface flex max-w-[400px] flex-col gap-3 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-white px-4 py-3 text-[14.5px]">
                  Se nos cayó la página un fin de semana y nadie se dio cuenta hasta el lunes…
                </div>
                <div class="bg-chipbg text-ink max-w-[85%] self-end rounded-2xl rounded-br-md px-4 py-3 text-[14.5px]">
                  Eso no tiene por qué repetirse. Agendemos 30 minutos. ¿Mañana a las 9?
                </div>
                <span class="text-inksoft self-end font-mono text-[11px]">conversación de ejemplo</span>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:order-2 lg:pl-16">
              <span class="eyebrow text-action">Día 1</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Recibes tu plan de soporte</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Qué se monitorea, con qué frecuencia se respalda, cuántas horas de mejora incluye
                y cuánto cuesta al mes, fijo y por escrito.
              </p>
            </div>
            <div class="lg:order-1 lg:flex lg:justify-end lg:pr-16">
              <div class="border-cardline bg-surface flex w-full max-w-[400px] flex-col gap-3.5 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="border-cardline flex items-center justify-between border-b pb-3">
                  <span class="font-display text-[15px] font-bold">Plan mensual</span>
                  <span class="bg-chipbg text-action rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">Fijo</span>
                </div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Monitoreo y alertas configuradas</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Copias de respaldo automáticas</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Horas de mejora incluidas</span></div>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:items-end lg:pr-16 lg:text-right">
              <span class="eyebrow text-action">Primer mes</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Blindamos tu operación</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Activamos el monitoreo, automatizamos los respaldos y auditamos la seguridad.
                Desde ese momento, cualquier caída nos despierta a nosotros, no a ti.
              </p>
            </div>
            <div class="lg:pl-16">
              <div class="border-cardline bg-surface flex max-w-[400px] flex-col gap-3.5 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Hito 1 · Monitoreo activo</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Hito 2 · Respaldos automáticos</span></div>
                <div class="flex items-center gap-2.5">
                  <span class="border-cardline h-[18px] w-[18px] shrink-0 rounded-full border-2 bg-white" aria-hidden="true"></span>
                  <span class="text-inksoft text-[14.5px] font-semibold">Hito 3 · Auditoría de seguridad</span>
                </div>
                <div class="mt-1 h-2 overflow-hidden rounded-full bg-white">
                  <div class="from-cyan to-peri h-2 w-[70%] rounded-full bg-gradient-to-r"></div>
                </div>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:order-2 lg:pl-16">
              <span class="eyebrow text-action">Cada mes</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Tú creces, nosotros mantenemos</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Recibes un informe claro de disponibilidad, incidentes resueltos y mejoras
                entregadas, y usas tus horas del plan para seguir evolucionando tu sitio.
              </p>
            </div>
            <div class="lg:order-1 lg:flex lg:justify-end lg:pr-16">
              <div class="border-cardline bg-surface flex w-full max-w-[400px] flex-col gap-3 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="border-cardline flex items-center justify-between border-b pb-3">
                  <span class="font-display text-[15px] font-bold">Informe mensual</span>
                  <span class="bg-chipbg text-action rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">ejemplo</span>
                </div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Disponibilidad</span><span class="font-display text-lg font-extrabold">99,9 %</span></div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Incidentes resueltos</span><span class="font-display text-lg font-extrabold">2</span></div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Mejoras entregadas</span><span class="font-display text-action text-lg font-extrabold">4</span></div>
              </div>
            </div>
          </li>
        </ol>
      </StoryTimeline>
    </div>
  </section>

  <section class="bg-surface px-6 pt-20 pb-4 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-3xl bg-[linear-gradient(150deg,#0F1D66_0%,#1B32A8_60%,#14267B_100%)] p-10 text-white lg:flex-row lg:items-center lg:p-16">
      <div class="flex max-w-[58ch] flex-col gap-3">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance lg:text-4xl">
          ¿Quién se entera si tu web se cae un domingo?
        </h2>
        <p class="text-textsoft text-lg leading-relaxed">
          Nosotros. Y trabajamos para resolverlo antes de que tus clientes lo noten.
        </p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-3">
        <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 text-center font-extrabold transition hover:brightness-105">
          Agendar diagnóstico gratuito
        </a>
        <span class="text-textblue font-mono text-xs">30 minutos · sin compromiso</span>
      </div>
    </div>
  </section>

  <section id="contacto" class="bg-surface scroll-mt-20 px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col items-start gap-5">
        <span class="eyebrow text-action">Contacto</span>
        <h2 class="font-display text-3xl font-bold tracking-tight text-balance lg:text-[38px]">
          Protege lo que ya construiste.
        </h2>
        <p class="text-inksoft max-w-[50ch] leading-relaxed">
          Cuéntanos qué sitio o tienda quieres proteger y te contactamos con una evaluación de su
          estado y una propuesta de plan en menos de 24 horas hábiles.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Diagnóstico gratuito de 30 minutos</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Cuidamos sitios hechos por otros</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Plan mensual fijo, sin permanencia</span></li>
        </ul>
      </div>
      <div class="border-cardline rounded-3xl border bg-white p-7 lg:p-10">
        <LeadForm />
      </div>
    </div>
  </section>

  <Footer />
</Base>
