---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Logo from '../components/Logo.astro';
import { SITE, TEAM } from '../config.js';


const principios = [
  {
    icon: 'check',
    title: 'Hablamos claro',
    description: 'Te explicamos qué vamos a hacer sin jerga técnica, y te decimos que no cuando algo no te conviene.',
  },
  {
    icon: 'shield',
    title: 'Inversión fija por escrito',
    description: 'El alcance lo firma quien va a construirlo, así que el precio no cambia a mitad de camino.',
  },
  {
    icon: 'qa',
    title: 'Nada se aprueba sin verlo',
    description: 'Trabajamos por hitos y te mostramos cada avance funcionando con datos reales antes de seguir.',
  },
  {
    icon: 'cap',
    title: 'Te dejamos manejando',
    description: 'Capacitamos a tu equipo para que use lo que construimos. No queremos que dependas de nosotros.',
  },
];
---

<Base
  title="Quiénes somos"
  description="Johan Bautista y Julián Díaz, los dos socios detrás de AlquimIA: optimización de procesos y desarrollo de software, los dos con IA y automatización aplicadas a empresas."
  path="/quienes-somos/"
>
  <Nav />

  <section class="relative overflow-hidden bg-[linear-gradient(155deg,#0C1650_0%,#142878_52%,#0A1240_100%)] text-white">
    <div class="absolute top-24 -right-16 h-[420px] w-[420px] rounded-full bg-[rgba(111,227,244,0.14)] blur-[90px]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-20">
      <div class="flex flex-col items-start gap-7">
      <span class="eyebrow border-cardnavyline text-textblue max-w-full rounded-full border bg-[rgba(20,34,110,0.5)] px-4 py-1.5 text-center">
        Quiénes somos
      </span>
      <h1 class="font-display max-w-[15ch] text-[38px] leading-[1.08] font-extrabold tracking-tight text-balance sm:text-[48px] lg:text-[54px]">
        Dos trayectorias,
        <span class="bg-gradient-to-r from-cyan to-peri bg-clip-text text-transparent">un mismo estándar</span>
        de trabajo.
      </h1>
      <p class="text-textsoft max-w-[56ch] text-lg leading-relaxed">
        Detrás de {SITE.brand} hay dos profesionales con años de proyectos de tecnología y mejora de
        procesos en empresas de distintos sectores: una trayectoria en optimización de procesos y
        otra en desarrollo y arquitectura de software, las dos con inteligencia artificial y
        automatización en el centro. Tu proyecto lo diseña y lo ejecuta ese mismo equipo, de
        principio a fin.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 font-extrabold transition hover:brightness-105">
          Agendar diagnóstico gratuito
        </a>
        <a href="/#servicios" class="rounded-full border-[1.5px] border-[#33489F] px-8 py-4 font-bold text-white transition hover:border-[#4a5fc0]">
          Ver todos los servicios
        </a>
      </div>
      <span class="text-textblue font-mono text-[12.5px]">Propuesta con alcance e inversión fija en 24 h hábiles.</span>
      </div>

      <div class="hidden justify-self-end lg:block">
        <div class="border-cardnavyline flex w-[400px] items-center justify-center rounded-3xl border bg-[linear-gradient(150deg,#0F1D66,#1B32A8)] px-12 py-20 shadow-[0_24px_60px_rgba(5,10,40,0.55)]">
          <Logo size="h-[38px]" class="max-w-full" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Los socios</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Dos miradas sobre el mismo problema.
        </h2>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          TEAM.map((socio) => (
            <article class="border-cardline flex flex-col gap-5 rounded-3xl border bg-white p-7 lg:p-9">
              <div class="flex flex-col items-start gap-2.5">
                <h3 class="font-display text-2xl font-bold tracking-tight">{socio.nombre}</h3>
                <span class="bg-chipbg text-action rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">
                  {socio.rol}
                </span>
              </div>
              <p class="text-inksoft leading-relaxed">{socio.intro}</p>
              <ul class="flex flex-col gap-3">
                {socio.puntos.map((punto) => (
                  <li class="flex items-start gap-3">
                    <Icon name="check" size={20} class="text-action mt-0.5 shrink-0" />
                    <span class="text-[15px] font-semibold">{punto}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-deep px-6 py-20 text-white lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-4 text-center">
        <span class="eyebrow text-textblue">El terreno común</span>
        <h2 class="font-display max-w-[30ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Los dos vivimos de la
          <span class="from-cyan to-peri bg-gradient-to-r bg-clip-text text-transparent">IA aplicada</span>.
        </h2>
        <p class="text-textsoft max-w-[64ch] leading-relaxed">
          No es que uno traiga el negocio y el otro la técnica. Los dos diseñamos y construimos
          agentes, flujos y automatizaciones. Por eso lo que te proponemos se puede construir, y lo
          que construimos tiene sentido para tu negocio.
        </p>
      </div>
      <div class="mt-14 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-3">
        <div class="flex flex-col items-center gap-2.5 text-center">
          <span class="from-cyan to-peri text-oncyan mb-1.5 inline-flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br shadow-[0_0_32px_rgba(111,227,244,0.25)]">
            <Icon name="circuit" size={24} />
          </span>
          <h3 class="font-display text-lg font-bold">Diagnóstico a cuatro ojos</h3>
          <p class="text-textmid max-w-[38ch] text-[15px] leading-relaxed">
            En la primera llamada estamos los dos: uno pregunta por el proceso y el otro por los
            sistemas. Sales con una lectura completa, no con la mitad.
          </p>
        </div>
        <div class="flex flex-col items-center gap-2.5 text-center">
          <span class="from-cyan to-peri text-oncyan mb-1.5 inline-flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br shadow-[0_0_32px_rgba(111,227,244,0.25)]">
            <Icon name="layers" size={24} />
          </span>
          <h3 class="font-display text-lg font-bold">Nada se promete sin saber construirlo</h3>
          <p class="text-textmid max-w-[38ch] text-[15px] leading-relaxed">
            El alcance lo firma quien va a programarlo. Por eso la inversión queda fija por escrito
            y no aparecen sorpresas a mitad del proyecto.
          </p>
        </div>
        <div class="flex flex-col items-center gap-2.5 text-center">
          <span class="from-cyan to-peri text-oncyan mb-1.5 inline-flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br shadow-[0_0_32px_rgba(111,227,244,0.25)]">
            <Icon name="shield" size={24} />
          </span>
          <h3 class="font-display text-lg font-bold">Te responde quien hizo el trabajo</h3>
          <p class="text-textmid max-w-[38ch] text-[15px] leading-relaxed">
            Cuando algo falla o quieres crecer, escribes al mismo par de personas que construyó tu
            solución. Sin tickets ni intermediarios.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Cómo trabajamos</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Cuatro cosas que no negociamos.
        </h2>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          principios.map((p) => (
            <article class="border-cardline bg-surface flex flex-col items-start gap-3.5 rounded-2xl border p-7">
              <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl">
                <Icon name={p.icon} size={26} />
              </span>
              <h3 class="font-display text-lg font-bold">{p.title}</h3>
              <p class="text-inksoft text-[15px] leading-relaxed">{p.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-surface px-6 pt-20 pb-4 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-3xl bg-[linear-gradient(150deg,#0F1D66_0%,#1B32A8_60%,#14267B_100%)] p-10 text-white lg:flex-row lg:items-center lg:p-16">
      <div class="flex max-w-[58ch] flex-col gap-3">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance lg:text-4xl">
          ¿Hablamos los tres?
        </h2>
        <p class="text-textsoft text-lg leading-relaxed">
          Media hora, sin compromiso y con los dos al otro lado. Sales sabiendo qué automatizar
          primero, así decidas no trabajar con nosotros.
        </p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-3">
        <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 text-center font-extrabold transition hover:brightness-105">
          Agendar diagnóstico gratuito
        </a>
        <span class="text-textblue font-mono text-xs">30 minutos · sin compromiso</span>
      </div>
    </div>
  </section>

  <section id="contacto" class="bg-surface scroll-mt-20 px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col items-start gap-5">
        <span class="eyebrow text-action">Contacto</span>
        <h2 class="font-display text-3xl font-bold tracking-tight text-balance lg:text-[38px]">
          Cuéntanos en qué andas.
        </h2>
        <p class="text-inksoft max-w-[50ch] leading-relaxed">
          Escríbenos y te contactamos con una evaluación inicial y una propuesta de alcance en menos
          de 24 horas hábiles.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Diagnóstico gratuito de 30 minutos</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Sin compromiso</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Te responde un socio, no un bot</span></li>
        </ul>
      </div>
      <div class="border-cardline rounded-3xl border bg-white p-7 lg:p-10">
        <LeadForm />
      </div>
    </div>
  </section>

  <Footer />
</Base>
