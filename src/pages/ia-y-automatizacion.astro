---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import StoryTimeline from '../components/StoryTimeline.astro';
import TechStrip from '../components/TechStrip.astro';
---

<Base
  title="Agentes de IA y Automatización para Empresas"
  description="Chatbots, agentes de IA y automatizaciones con n8n conectadas a WhatsApp y a tu CRM: responden en segundos, clasifican leads y liberan a tu equipo del trabajo repetitivo."
  path="/ia-y-automatizacion/"
>
  <Nav />

  <section class="relative overflow-hidden bg-[linear-gradient(155deg,#0C1650_0%,#142878_52%,#0A1240_100%)] text-white">
    <div class="absolute top-24 -right-16 h-[420px] w-[420px] rounded-full bg-[rgba(111,227,244,0.14)] blur-[90px]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-20">
      <div class="flex flex-col items-start gap-7">
        <span class="eyebrow border-cardnavyline text-textblue max-w-full rounded-full border bg-[rgba(20,34,110,0.5)] px-4 py-1.5 text-center">
          Servicio · IA y automatización
        </span>
        <h1 class="font-display text-[38px] leading-[1.08] font-extrabold tracking-tight text-balance sm:text-[48px] lg:text-[54px]">
          IA para vender más y
          <span class="bg-gradient-to-r from-cyan to-peri bg-clip-text text-transparent">operar mejor</span>.
        </h1>
        <p class="text-textsoft max-w-[52ch] text-lg leading-relaxed">
          Chatbots, agentes y automatizaciones conectados a WhatsApp, a tu CRM y a tus sistemas
          internos: responden en segundos, clasifican leads y eliminan el trabajo repetitivo de tu
          operación.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 font-extrabold transition hover:brightness-105">
            Agendar diagnóstico gratuito
          </a>
          <a href="/#servicios" class="rounded-full border-[1.5px] border-[#33489F] px-8 py-4 font-bold text-white transition hover:border-[#4a5fc0]">
            Ver todos los servicios
          </a>
        </div>
        <span class="text-textblue font-mono text-[12.5px]">Sabrás qué automatizar primero en 30 minutos.</span>
      </div>

      <div class="hidden justify-self-end lg:block">
        <div class="bg-cardnavy border-cardnavyline flex w-[360px] flex-col gap-3.5 rounded-2xl border p-6 font-mono text-[13px] shadow-[0_24px_60px_rgba(5,10,40,0.55)]">
          <div class="flex items-center justify-between border-b border-[#22347F] pb-3">
            <span class="text-[#8DA0E8]">agente · flujo-leads · n8n</span>
            <span class="bg-cyan inline-block h-2 w-2 rounded-full"></span>
          </div>
          <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Lead recibido · WhatsApp</span></div>
          <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Intención alta (0,92)</span></div>
          <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Respuesta enviada · 38 s</span></div>
          <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">CRM actualizado · seguimiento</span></div>
          <div class="flex items-center gap-2.5"><span class="inline-block h-[7px] w-[7px] rounded-full bg-[#556AC9]"></span><span class="text-[#8DA0E8]">Reporte diario programado</span></div>
          <span class="text-[10.5px] text-[#7D8FD9]">simulación de ejemplo</span>
        </div>
      </div>
    </div>
  </section>

  <TechStrip names={['n8n', 'claude', 'python', 'fastapi']} label="Construido sobre" />

  <section class="bg-surface px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Qué construimos</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Automatización con un objetivo comercial, no por moda.
        </h2>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="circuit" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Chatbots de ventas y soporte</h3>
          <p class="text-inksoft leading-relaxed">Atienden en WhatsApp y en tu web, responden preguntas frecuentes, califican al cliente y escalan a tu equipo cuando hace falta un humano.</p>
        </article>
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="browser" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Flujos de trabajo internos</h3>
          <p class="text-inksoft leading-relaxed">Con n8n y Python automatizamos lo repetitivo: pedidos, facturas, reportes y dashboards: los procesos que hoy consumen horas de tu equipo.</p>
        </article>
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="shield" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Integraciones que conectan todo</h3>
          <p class="text-inksoft leading-relaxed">WhatsApp Business, tu CRM, tu ERP y tus herramientas internas hablando entre sí, con reglas de negocio claras y trazabilidad completa.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="scroll-mt-20 overflow-hidden bg-white px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Cómo trabajamos</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          De la sobrecarga a una operación que trabaja sola.
        </h2>
      </div>

      <StoryTimeline>
        <ol class="flex flex-col gap-16">
          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:items-end lg:pr-16 lg:text-right">
              <span class="eyebrow text-action">Día 0</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Nos cuentas tu operación</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Todo empieza con un mensaje. Revisamos tus procesos junto a tu equipo, mapeamos tus
                sistemas y tus datos, y priorizamos el problema con mayor impacto de negocio y
                viabilidad técnica.
              </p>
            </div>
            <div class="lg:pl-16">
              <div class="border-cardline bg-surface flex max-w-[400px] flex-col gap-3 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-white px-4 py-3 text-[14.5px]">
                  Hola, respondo pedidos por WhatsApp hasta las 11 de la noche y no doy abasto…
                </div>
                <div class="bg-chipbg text-ink max-w-[85%] self-end rounded-2xl rounded-br-md px-4 py-3 text-[14.5px]">
                  Agendemos 30 minutos y lo revisamos. ¿Mañana a las 9?
                </div>
                <span class="text-inksoft self-end font-mono text-[11px]">conversación de ejemplo</span>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:order-2 lg:pl-16">
              <span class="eyebrow text-action">Día 1</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Recibes el plano de tu automatización</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                La arquitectura de la solución: qué modelos y flujos usaremos, cómo viajan tus
                datos de extremo a extremo, qué riesgos y dependencias existen, con inversión
                fija por escrito.
              </p>
            </div>
            <div class="lg:order-1 lg:flex lg:justify-end lg:pr-16">
              <div class="border-cardline bg-surface flex w-full max-w-[400px] flex-col gap-3.5 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="border-cardline flex items-center justify-between border-b pb-3">
                  <span class="font-display text-[15px] font-bold">Blueprint del agente</span>
                  <span class="bg-chipbg text-action rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">Sin sorpresas</span>
                </div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Arquitectura: modelos, flujos e integraciones</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Flujo de datos de extremo a extremo</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Inversión fija por escrito</span></div>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:items-end lg:pr-16 lg:text-right">
              <span class="eyebrow text-action">Semana a semana</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Tu agente aprende tu negocio</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Construimos los flujos en un entorno seguro, integramos con tu infraestructura
                existente (ERP, CRM, herramientas internas) y probamos con datos reales antes de
                dejarlo frente a tus clientes.
              </p>
            </div>
            <div class="lg:pl-16">
              <div class="border-cardline bg-surface flex max-w-[400px] flex-col gap-3.5 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Hito 1 · Flujos conectados</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Hito 2 · Pruebas con casos reales</span></div>
                <div class="flex items-center gap-2.5">
                  <span class="border-cardline h-[18px] w-[18px] shrink-0 rounded-full border-2 bg-white" aria-hidden="true"></span>
                  <span class="text-inksoft text-[14.5px] font-semibold">Hito 3 · Agente en entrenamiento</span>
                </div>
                <div class="mt-1 h-2 overflow-hidden rounded-full bg-white">
                  <div class="from-cyan to-peri h-2 w-[70%] rounded-full bg-gradient-to-r"></div>
                </div>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:order-2 lg:pl-16">
              <span class="eyebrow text-action">Desde el lanzamiento</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Tu operación empieza a trabajar sola</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Desplegamos en producción con documentación técnica completa y capacitamos a tu
                equipo para que la adopción sea real. Ajustamos con datos y escalamos a nuevas
                áreas cuando estés listo.
              </p>
            </div>
            <div class="lg:order-1 lg:flex lg:justify-end lg:pr-16">
              <div class="border-cardline bg-surface flex w-full max-w-[400px] flex-col gap-3 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="border-cardline flex items-center justify-between border-b pb-3">
                  <span class="font-display text-[15px] font-bold">Reporte semanal</span>
                  <span class="bg-chipbg text-action rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">ejemplo</span>
                </div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Leads atendidos</span><span class="font-display text-lg font-extrabold">34</span></div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Fuera de horario</span><span class="font-display text-lg font-extrabold">11</span></div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Tiempo medio de respuesta</span><span class="font-display text-action text-lg font-extrabold">41 s</span></div>
              </div>
            </div>
          </li>
        </ol>
      </StoryTimeline>
    </div>
  </section>

  <section class="bg-surface px-6 pt-20 pb-4 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-3xl bg-[linear-gradient(150deg,#0F1D66_0%,#1B32A8_60%,#14267B_100%)] p-10 text-white lg:flex-row lg:items-center lg:p-16">
      <div class="flex max-w-[58ch] flex-col gap-3">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance lg:text-4xl">
          Tu próximo cliente escribe a las 11&nbsp;p.&nbsp;m.
        </h2>
        <p class="text-textsoft text-lg leading-relaxed">
          Un agente bien entrenado le responde en segundos, y tú decides al día siguiente con la
          información completa.
        </p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-3">
        <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 text-center font-extrabold transition hover:brightness-105">
          Agendar diagnóstico gratuito
        </a>
        <span class="text-textblue font-mono text-xs">30 minutos · sin compromiso</span>
      </div>
    </div>
  </section>

  <section id="contacto" class="bg-surface scroll-mt-20 px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col items-start gap-5">
        <span class="eyebrow text-action">Contacto</span>
        <h2 class="font-display text-3xl font-bold tracking-tight text-balance lg:text-[38px]">
          Descubre qué automatizar primero.
        </h2>
        <p class="text-inksoft max-w-[50ch] leading-relaxed">
          Cuéntanos cómo atiende tu equipo hoy y te contactamos con una evaluación inicial y una
          propuesta de alcance en menos de 24 horas hábiles.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Diagnóstico gratuito de 30 minutos</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Sin compromiso</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Respuesta de un consultor, no de un bot</span></li>
        </ul>
      </div>
      <div class="border-cardline rounded-3xl border bg-white p-7 lg:p-10">
        <LeadForm />
      </div>
    </div>
  </section>

  <Footer />
</Base>
