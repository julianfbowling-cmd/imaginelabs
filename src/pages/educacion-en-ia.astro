---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import StoryTimeline from '../components/StoryTimeline.astro';
import TechStrip from '../components/TechStrip.astro';
---

<Base
  title="Formación en Inteligencia Artificial para Empresas"
  description="Talleres y programas prácticos de IA para equipos: tu gente aprende a usar la inteligencia artificial en su trabajo real, con casos de tu empresa y reglas claras de uso."
  path="/educacion-en-ia/"
>
  <Nav />

  <section class="relative overflow-hidden bg-[linear-gradient(155deg,#0C1650_0%,#142878_52%,#0A1240_100%)] text-white">
    <div class="absolute top-24 -right-16 h-[420px] w-[420px] rounded-full bg-[rgba(111,227,244,0.14)] blur-[90px]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-20">
      <div class="flex flex-col items-start gap-7">
        <span class="eyebrow border-cardnavyline text-textblue max-w-full rounded-full border bg-[rgba(20,34,110,0.5)] px-4 py-1.5 text-center">
          Servicio · Educación en IA
        </span>
        <h1 class="font-display text-[38px] leading-[1.08] font-extrabold tracking-tight text-balance sm:text-[48px] lg:text-[54px]">
          Tu equipo, listo para
          <span class="bg-gradient-to-r from-cyan to-peri bg-clip-text text-transparent">trabajar con IA</span>.
        </h1>
        <p class="text-textsoft max-w-[52ch] text-lg leading-relaxed">
          Talleres y programas prácticos con los casos reales de tu empresa: tu gente aprende qué
          puede hacer la inteligencia artificial, cómo usarla bien y dónde no usarla.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 font-extrabold transition hover:brightness-105">
            Agendar diagnóstico gratuito
          </a>
          <a href="/#servicios" class="rounded-full border-[1.5px] border-[#33489F] px-8 py-4 font-bold text-white transition hover:border-[#4a5fc0]">
            Ver todos los servicios
          </a>
        </div>
        <span class="text-textblue font-mono text-[12.5px]">Programa a la medida de tu equipo, no un curso enlatado.</span>
      </div>

      <div class="hidden justify-self-end lg:block">
        <div class="bg-cardnavy border-cardnavyline flex w-[360px] flex-col gap-3.5 rounded-2xl border p-6 font-mono text-[13px] shadow-[0_24px_60px_rgba(5,10,40,0.55)]">
          <div class="flex items-center justify-between border-b border-[#22347F] pb-3">
            <span class="text-[#8DA0E8]">programa · IA aplicada · cohorte 1</span>
            <span class="bg-cyan inline-block h-2 w-2 rounded-full"></span>
          </div>
          <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Módulo 1 · Qué hace y qué no hace la IA</span></div>
          <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Módulo 2 · Prompts para tu trabajo real</span></div>
          <div class="flex items-center gap-2.5"><span class="bg-cyan inline-block h-[7px] w-[7px] rounded-full"></span><span class="text-[#D5DDFA]">Módulo 3 · Datos y uso responsable</span></div>
          <div class="flex items-center gap-2.5"><span class="inline-block h-[7px] w-[7px] rounded-full bg-[#556AC9]"></span><span class="text-[#8DA0E8]">Módulo 4 · Automatiza tu propio caso</span></div>
          <div class="mt-1 h-2 overflow-hidden rounded-full bg-[rgba(20,34,110,0.8)]">
            <div class="from-cyan to-peri h-2 w-[75%] rounded-full bg-gradient-to-r"></div>
          </div>
          <span class="text-[10.5px] text-[#7D8FD9]">programa de ejemplo</span>
        </div>
      </div>
    </div>
  </section>

  <TechStrip names={['claude', 'n8n', 'python']} label="Herramientas que tu equipo aprende a usar" />

  <section class="bg-surface px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Qué enseñamos</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          Formación práctica, con los casos de tu empresa.
        </h2>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="cap" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Talleres de IA aplicada</h3>
          <p class="text-inksoft leading-relaxed">Sesiones prácticas por área, comercial, operaciones o administración, donde cada persona sale con la IA resolviendo una tarea de su propio día.</p>
        </article>
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="layers" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Programas por rol</h3>
          <p class="text-inksoft leading-relaxed">Una ruta para dirección, otra para líderes y otra para quienes operan: cada quien aprende lo que su cargo necesita decidir o ejecutar, sin relleno técnico.</p>
        </article>
        <article class="border-cardline flex flex-col items-start gap-3.5 rounded-2xl border bg-white p-7">
          <span class="bg-chipbg text-action inline-flex h-13 w-13 items-center justify-center rounded-2xl"><Icon name="shield" size={26} /></span>
          <h3 class="font-display text-xl font-bold">Política de uso responsable</h3>
          <p class="text-inksoft leading-relaxed">Reglas claras sobre qué datos se pueden compartir, cómo validar lo que responde un modelo y cómo dejar registro del uso, escritas para tu empresa.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="scroll-mt-20 overflow-hidden bg-white px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="eyebrow text-action">Cómo trabajamos</span>
        <h2 class="font-display max-w-[26ch] text-3xl font-bold tracking-tight text-balance lg:text-4xl">
          De la curiosidad a la IA usándose todos los días.
        </h2>
      </div>

      <StoryTimeline>
        <ol class="flex flex-col gap-16">
          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:items-end lg:pr-16 lg:text-right">
              <span class="eyebrow text-action">Día 0</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Nos cuentas cómo trabaja tu equipo</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Revisamos qué hace cada área, qué tareas consumen más tiempo y qué tanto sabe hoy tu
                gente de IA. De ahí sale el nivel y el contenido, no de un temario genérico.
              </p>
            </div>
            <div class="lg:pl-16">
              <div class="border-cardline bg-surface flex max-w-[400px] flex-col gap-3 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-white px-4 py-3 text-[14.5px]">
                  Mi equipo ya usa IA por su cuenta, pero nadie sabe si lo está haciendo bien…
                </div>
                <div class="bg-chipbg text-ink max-w-[85%] self-end rounded-2xl rounded-br-md px-4 py-3 text-[14.5px]">
                  Agendemos 30 minutos y armamos el programa. ¿Mañana a las 9?
                </div>
                <span class="text-inksoft self-end font-mono text-[11px]">conversación de ejemplo</span>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:order-2 lg:pl-16">
              <span class="eyebrow text-action">Día 1</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Recibes el plan de formación</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Módulos por rol, casos tomados de tu operación, número de sesiones y cómo mediremos
                el resultado. Todo por escrito, con inversión fija en 24 horas hábiles.
              </p>
            </div>
            <div class="lg:order-1 lg:flex lg:justify-end lg:pr-16">
              <div class="border-cardline bg-surface flex w-full max-w-[400px] flex-col gap-3.5 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="border-cardline flex items-center justify-between border-b pb-3">
                  <span class="font-display text-[15px] font-bold">Plan de formación</span>
                  <span class="bg-chipbg text-action rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">Sin sorpresas</span>
                </div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Módulos y sesiones por rol</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Casos reales de tu empresa</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Inversión fija por escrito</span></div>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:items-end lg:pr-16 lg:text-right">
              <span class="eyebrow text-action">Durante el programa</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">Tu equipo practica con su propio trabajo</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Cada sesión combina explicación corta y práctica guiada: al terminar, cada persona
                se lleva algo funcionando en su cargo, no apuntes que nadie vuelve a abrir.
              </p>
            </div>
            <div class="lg:pl-16">
              <div class="border-cardline bg-surface flex max-w-[400px] flex-col gap-3.5 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Sesión 1 · Fundamentos y límites de la IA</span></div>
                <div class="flex items-center gap-2.5"><Icon name="check" size={18} class="text-action shrink-0" /><span class="text-[14.5px] font-semibold">Sesión 2 · Casos por área, en vivo</span></div>
                <div class="flex items-center gap-2.5">
                  <span class="border-cardline h-[18px] w-[18px] shrink-0 rounded-full border-2 bg-white" aria-hidden="true"></span>
                  <span class="text-inksoft text-[14.5px] font-semibold">Sesión 3 · Cada quien automatiza su tarea</span>
                </div>
                <div class="mt-1 h-2 overflow-hidden rounded-full bg-white">
                  <div class="from-cyan to-peri h-2 w-[70%] rounded-full bg-gradient-to-r"></div>
                </div>
              </div>
            </div>
          </li>

          <li class="step relative grid grid-cols-1 gap-6 pl-12 lg:grid-cols-2 lg:gap-0 lg:pl-0">
            <span class="dot absolute top-1.5 left-[2px] h-[18px] w-[18px] rounded-full border-2 lg:left-1/2 lg:-translate-x-1/2" aria-hidden="true"></span>
            <div class="flex flex-col items-start gap-3 lg:order-2 lg:pl-16">
              <span class="eyebrow text-action">Al cerrar</span>
              <h3 class="font-display text-2xl font-bold tracking-tight">La IA se queda en el día a día</h3>
              <p class="text-inksoft max-w-[46ch] leading-relaxed">
                Entregamos material de consulta, la política de uso responsable y un informe de lo
                que quedó funcionando. Si quieres, acompañamos a tu equipo los meses siguientes.
              </p>
            </div>
            <div class="lg:order-1 lg:flex lg:justify-end lg:pr-16">
              <div class="border-cardline bg-surface flex w-full max-w-[400px] flex-col gap-3 rounded-2xl border p-5 shadow-[0_12px_32px_rgba(13,20,64,0.06)]">
                <div class="border-cardline flex items-center justify-between border-b pb-3">
                  <span class="font-display text-[15px] font-bold">Cierre del programa</span>
                  <span class="bg-chipbg text-action rounded-full px-3 py-1 text-[11px] font-extrabold tracking-wider uppercase">ejemplo</span>
                </div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Personas formadas</span><span class="font-display text-lg font-extrabold">24</span></div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Casos en uso al mes siguiente</span><span class="font-display text-lg font-extrabold">9</span></div>
                <div class="flex items-center justify-between"><span class="text-inksoft text-[14px]">Política de uso publicada</span><span class="font-display text-action text-lg font-extrabold">Sí</span></div>
              </div>
            </div>
          </li>
        </ol>
      </StoryTimeline>
    </div>
  </section>

  <section class="bg-surface px-6 pt-20 pb-4 lg:px-10">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 rounded-3xl bg-[linear-gradient(150deg,#0F1D66_0%,#1B32A8_60%,#14267B_100%)] p-10 text-white lg:flex-row lg:items-center lg:p-16">
      <div class="flex max-w-[58ch] flex-col gap-3">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance lg:text-4xl">
          Tu equipo ya está usando IA. ¿Con qué criterio?
        </h2>
        <p class="text-textsoft text-lg leading-relaxed">
          Un equipo formado la usa mejor: mejores resultados, menos errores y tus datos protegidos.
        </p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-3">
        <a href="#contacto" class="bg-cyan text-oncyan rounded-full px-8 py-4 text-center font-extrabold transition hover:brightness-105">
          Agendar diagnóstico gratuito
        </a>
        <span class="text-textblue font-mono text-xs">30 minutos · sin compromiso</span>
      </div>
    </div>
  </section>

  <section id="contacto" class="bg-surface scroll-mt-20 px-6 py-20 lg:px-10 lg:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col items-start gap-5">
        <span class="eyebrow text-action">Contacto</span>
        <h2 class="font-display text-3xl font-bold tracking-tight text-balance lg:text-[38px]">
          Diseñemos la formación de tu equipo.
        </h2>
        <p class="text-inksoft max-w-[50ch] leading-relaxed">
          Cuéntanos cuántas personas son y qué hace cada área, y te contactamos con una propuesta de
          contenidos y alcance en menos de 24 horas hábiles.
        </p>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Diagnóstico gratuito de 30 minutos</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Presencial en Colombia o en línea</span></li>
          <li class="flex items-center gap-3"><Icon name="check" size={20} class="text-action shrink-0" /><span class="font-semibold">Sin conocimientos técnicos previos</span></li>
        </ul>
      </div>
      <div class="border-cardline rounded-3xl border bg-white p-7 lg:p-10">
        <LeadForm />
      </div>
    </div>
  </section>

  <Footer />
</Base>
