---
import { SITE, NAV_LINKS } from '../config.js';
import Icon from './Icon.astro';
---

<header class="border-navline/70 bg-deep/85 sticky top-0 z-50 border-b backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
    <a href="/" class="flex items-center gap-3 text-white">
      <Icon name="circuit" size={26} class="text-cyan" />
      <span class="font-display text-lg font-bold tracking-tight">{SITE.brand}</span>
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="text-textmid text-[15px] font-semibold transition-colors hover:text-white">
            {link.label}
          </a>
        ))
      }
    </nav>
    <a
      href="#contacto"
      class="bg-cyan text-oncyan rounded-full px-5 py-2.5 text-sm font-extrabold transition hover:brightness-105"
    >
      Agendar diagnóstico
    </a>
  </div>
</header>
