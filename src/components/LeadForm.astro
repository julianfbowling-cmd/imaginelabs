---
// Formulario de captura. Usa el primer backend configurado (ver .env.example):
// 1. PUBLIC_N8N_WEBHOOK_URL: webhook de n8n (cuando exista una instancia).
// 2. PUBLIC_SUPABASE_URL + PUBLIC_SUPABASE_ANON_KEY: inserta en la tabla
//    public.leads (ver supabase/leads.sql; la anon key solo puede insertar).
// 3. PUBLIC_WEB3FORMS_KEY: Web3Forms entrega los leads por correo.
// Sin ninguno configurado, informa al visitante en lugar de fallar en silencio.
---

<form id="lead-form" class="flex flex-col gap-4" novalidate>
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" aria-hidden="true" />
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-semibold">Nombre *</span>
      <input
        type="text"
        name="nombre"
        required
        autocomplete="name"
        class="border-cardline focus:border-action rounded-xl border bg-white px-4 py-3 text-[15px] outline-none"
      />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-semibold">Correo *</span>
      <input
        type="email"
        name="correo"
        required
        autocomplete="email"
        class="border-cardline focus:border-action rounded-xl border bg-white px-4 py-3 text-[15px] outline-none"
      />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-semibold">WhatsApp</span>
      <input
        type="tel"
        name="whatsapp"
        autocomplete="tel"
        class="border-cardline focus:border-action rounded-xl border bg-white px-4 py-3 text-[15px] outline-none"
      />
    </label>
    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-semibold">Empresa</span>
      <input
        type="text"
        name="empresa"
        autocomplete="organization"
        class="border-cardline focus:border-action rounded-xl border bg-white px-4 py-3 text-[15px] outline-none"
      />
    </label>
  </div>
  <label class="flex flex-col gap-1.5">
    <span class="text-sm font-semibold">¿Qué quieres lograr? *</span>
    <textarea
      name="mensaje"
      required
      rows="4"
      class="border-cardline focus:border-action resize-y rounded-xl border bg-white px-4 py-3 text-[15px] outline-none"
      placeholder="Cuéntanos tu objetivo comercial: qué vendes, qué te quita tiempo, qué quieres automatizar."></textarea>
  </label>
  <button
    type="submit"
    class="bg-cyan text-oncyan self-start rounded-full px-8 py-4 font-extrabold transition hover:brightness-105 disabled:opacity-60"
  >
    Enviar solicitud
  </button>
  <p id="form-status" class="text-inksoft min-h-5 text-sm" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;
  const button = form.querySelector('button') as HTMLButtonElement;
  const n8nUrl = import.meta.env.PUBLIC_N8N_WEBHOOK_URL;
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = Object.fromEntries(new FormData(form).entries());

    // Honeypot: los bots marcan el checkbox oculto; fingimos éxito y descartamos.
    if (data.botcheck) {
      form.reset();
      status.textContent = 'Recibido. Te contactamos en menos de 24 horas hábiles.';
      return;
    }
    delete data.botcheck;

    if (!n8nUrl && !(supabaseUrl && supabaseKey) && !web3formsKey) {
      status.textContent =
        'El formulario aún no está conectado. Escríbenos por correo mientras lo activamos.';
      return;
    }

    button.disabled = true;
    status.textContent = 'Enviando…';

    try {
      if (n8nUrl) {
        const res = await fetch(n8nUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, origen: 'web', pagina: location.pathname }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
      } else if (supabaseUrl && supabaseKey) {
        const res = await fetch(`${supabaseUrl}/rest/v1/leads`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: supabaseKey,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            nombre: data.nombre,
            correo: data.correo,
            whatsapp: data.whatsapp || null,
            empresa: data.empresa || null,
            mensaje: data.mensaje,
            pagina: location.pathname,
            origen: 'web',
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
      } else {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: web3formsKey,
            subject: `Nuevo lead: ${data.nombre} (AlquimIA)`,
            from_name: 'Web AlquimIA',
            email: data.correo,
            ...data,
            pagina: location.pathname,
          }),
        });
        const out = await res.json();
        if (!out.success) throw new Error('web3forms');
      }
      form.reset();
      status.textContent = 'Recibido. Te contactamos en menos de 24 horas hábiles.';
    } catch {
      status.textContent = 'No pudimos enviar tu solicitud. Intenta de nuevo o escríbenos por correo.';
    } finally {
      button.disabled = false;
    }
  });
</script>
