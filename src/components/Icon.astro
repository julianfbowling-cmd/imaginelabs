---
// Iconos de trazo del sistema (24px de retícula, recolorean con currentColor).
const { name, size = 24, class: className = '' } = Astro.props;

const paths = {
  circuit: '<rect x="8" y="8" width="8" height="8" rx="1.5"></rect><path d="M12 3v5M12 16v5M3 12h5M16 12h5"></path>',
  browser: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 9h18"></path><path d="M6.5 7h0.01"></path>',
  bag: '<path d="M6 8h12l-1 12H7L6 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path>',
  shield: '<path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6l-8-3Z"></path>',
  check: '<circle cx="12" cy="12" r="9"></circle><path d="m8 12.4 2.8 2.6L16 9.4"></path>',
  arrow: '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>',
  pencil: '<path d="m15 5 4 4"></path><path d="M13 7 4 16l-1 5 5-1 9-9"></path>',
  layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"></path><path d="m3 13 9 5 9-5"></path>',
  code: '<path d="m8 8-5 4 5 4"></path><path d="m16 8 5 4-5 4"></path><path d="m13 5-3 14"></path>',
  qa: '<circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path><path d="m8.5 11 1.8 1.8 3.2-3.6"></path>',
  cloud: '<path d="M17.5 18a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.6 1.6A4 4 0 0 0 7 18h10.5Z"></path>',
  chart: '<path d="M4 4v16h16"></path><path d="M8.5 17v-4.5"></path><path d="M13 17V8.5"></path><path d="M17.5 17v-6.5"></path>',
  cap: '<path d="M12 4 2.5 8.5 12 13l9.5-4.5L12 4Z"></path><path d="M6.5 10.8V15c0 1.6 2.5 3 5.5 3s5.5-1.4 5.5-3v-4.2"></path><path d="M21.5 8.5v4.5"></path>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={paths[name]}
/>
