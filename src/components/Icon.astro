---
// Iconos de trazo del sistema (24px de retícula, recolorean con currentColor).
const { name, size = 24, class: className = '' } = Astro.props;

const paths = {
  circuit: '<rect x="8" y="8" width="8" height="8" rx="1.5"></rect><path d="M12 3v5M12 16v5M3 12h5M16 12h5"></path>',
  browser: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 9h18"></path><path d="M6.5 7h0.01"></path>',
  bag: '<path d="M6 8h12l-1 12H7L6 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path>',
  shield: '<path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6l-8-3Z"></path>',
  check: '<circle cx="12" cy="12" r="9"></circle><path d="m8 12.4 2.8 2.6L16 9.4"></path>',
  arrow: '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={paths[name]}
/>
